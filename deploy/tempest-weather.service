[Unit]
Description=Tempest Weather FastAPI Service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WatchdogSec=30
User=mcdomx
Group=mcdomx
WorkingDirectory=/home/mcdomx/tempest_weather
EnvironmentFile=/home/mcdomx/tempest_weather/.env
ExecStart=/home/mcdomx/tempest_weather/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
